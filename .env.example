# Required
JOPLIN_TOKEN=your_joplin_token_here
LLM_API_KEY=your_llm_api_key_here

# Optional (defaults shown)
JOPLIN_BASE_URL=http://localhost:41184
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
PROCESSED_TAG=ai-audited
FAILED_TAG=ai-failed
MACHINE_MARKER=<!-- ai_audited_v1 -->
PROMPT_FILE=system_prompt.txt
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_WARMUP_ENABLED=true
SEMANTIC_DEBUG=false
SEMANTIC_DEBUG_TOP_K=10
SEMANTIC_LOG_CANDIDATES_LIMIT=10
SEMANTIC_WARMUP_TEXT=warmup note for embedding model
SIMILARITY_THRESHOLD=0.6
SIMILARITY_TOP_K=5
REQUEST_TIMEOUT=90
LLM_TIMEOUT=90
PAUSE_BETWEEN_NOTES=1.5
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.8
LOG_FILE=logs/joplin_agent.log
